  "tokenColors": [
    {
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#6A9955", "fontStyle": "italic" }
    },
    {
      "scope": ["string.quoted.double.skript"],
      "settings": { "foreground": "#CE9178" }
    },
    {
      "scope": ["constant.character.escape.skript"],
      "settings": { "foreground": "#D7BA7D" }
    },
    {
      "scope": ["constant.numeric.skript"],
      "settings": { "foreground": "#B5CEA8" }
    },
    {
      "scope": ["keyword.control.skript", "keyword.control.conditional.skript"],
      "settings": { "foreground": "#C586C0" }
    },
    {
      "scope": [
        "keyword.control.function.skript",
        "keyword.control.command.skript",
        "keyword.control.event.skript",
        "keyword.control.section.skript"
      ],
      "settings": { "foreground": "#C586C0", "fontStyle": "bold" }
    },
    {
      "scope": ["keyword.other.effect.skript"],
      "settings": { "foreground": "#569CD6" }
    },
    {
      "scope": ["keyword.operator.logical.skript"],
      "settings": { "foreground": "#D4D4D4" }
    },
    {
      "scope": ["support.type.skript", "support.type.return.skript"],
      "settings": { "foreground": "#4EC9B0" }
    },
    {
      "scope": ["entity.name.function.skript"],
      "settings": { "foreground": "#DCDCAA", "fontStyle": "bold" }
    },
    {
      "scope": ["entity.name.function.call.skript"],
      "settings": { "foreground": "#F2C77E" }
    },
    {
      "scope": ["entity.name.function.command.skript"],
      "settings": { "foreground": "#4FC1FF" }
    },
    {
      "scope": ["entity.name.type.event.skript"],
      "settings": { "foreground": "#4FC1FF", "fontStyle": "bold" }
    },
    {
      "scope": ["variable.other.skript", "variable.other.name.skript"],
      "settings": { "foreground": "#9CDCFE" }
    },
    {
      "scope": ["variable.parameter.skript", "variable.parameter.command.skript"],
      "settings": { "foreground": "#9CDCFE", "fontStyle": "italic" }
    },
    {
      "scope": ["keyword.other.local-scope.skript"],
      "settings": { "foreground": "#D16969", "fontStyle": "bold" }
    },
    {
      "scope": ["constant.language.wildcard.skript"],
      "settings": { "foreground": "#D4D4D4", "fontStyle": "bold" }
    },
    {
      "scope": [
        "punctuation.definition.variable.begin.skript",
        "punctuation.definition.variable.end.skript",
        "punctuation.definition.expression.begin.skript",
        "punctuation.definition.expression.end.skript",
        "punctuation.separator.list.skript"
      ],
      "settings": { "foreground": "#858889" }
    },
    {
      "scope": ["meta.embedded.expression.skript", "variable.other.expression.skript"],
      "settings": { "foreground": "#9CDCFE" }
    },
    {
      "scope": [
        "punctuation.section.section-header.skript",
        "punctuation.section.parameters.begin.skript",
        "punctuation.section.parameters.end.skript",
        "punctuation.separator.parameter.skript",
        "punctuation.separator.type.skript",
        "punctuation.separator.return-type.skript"
      ],
      "settings": { "foreground": "#BBBEBF" }
    },
